<div class="header">
    <h1><%= @purpose == 'invite' ? 'Welcome' : 'Reset password' %></h1>
    <p class="tagline"><% if @token.user.choose_username %>Choose a username and password<% else %>Set a password for <b><%= @token.user.username %></b><% end %></p>
</div>

<section class="section">
    <% if @error %><div class="form-error-base"><div><%= @error %></div></div><% end %>
    <form class="invoice-form auth-form" method="post" action="/admin/<%= @purpose %>/<%= params[:token] %>">
        <input type="hidden" name="authenticity_token" value="<%= csrf_token %>" />
        <% if @token.user.choose_username %>
            <div class="field"><label for="username">Username <span class="optional">(lowercase letters, digits, . _ @ -)</span></label><input type="text" id="username" name="username" value="<%= params[:username] %>" autocomplete="username" autocapitalize="none" pattern="[a-z0-9][a-z0-9_.@-]{1,63}" required autofocus /></div>
        <% else %>
            <input type="text" name="username" value="<%= @token.user.username %>" autocomplete="username" hidden />
        <% end %>
        <div class="field"><label for="password">Password <span class="optional">(at least <%= User::MIN_PASS %> characters)</span></label><input type="password" id="password" name="password" autocomplete="new-password" minlength="<%= User::MIN_PASS %>" required autofocus /></div>
        <div class="field"><label for="confirm">Repeat password</label><input type="password" id="confirm" name="confirm" autocomplete="new-password" required /></div>
        <button type="submit" class="download-button">Set password and log in</button>
    </form>
</section>
