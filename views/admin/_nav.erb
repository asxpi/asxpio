<nav class="admin-nav">
    <% [['/admin', 'dashboard', nil], ['/admin/invoices', 'invoices', 'invoices'], ['/admin/bingo', 'bingo', 'bingo'], ['/admin/users', 'users', 'users']].each do |href, label, area| %>
        <% next if area && !can?(area, 'read') %>
        <a href="<%= href %>" class="<%= 'active' if href == '/admin' ? request.path == '/admin' : request.path.start_with?(href) %>"><%= label %></a>
    <% end %>
    <% if current_user %>
        <span class="admin-nav-user">
            <a href="/admin/account/password" title="Change password"><%= current_user.username %></a>
            <form method="post" action="/admin/logout"><input type="hidden" name="authenticity_token" value="<%= csrf_token %>" /><button type="submit" class="link-button">log out</button></form>
        </span>
    <% end %>
</nav>
